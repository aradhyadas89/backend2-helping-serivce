# ==============================================================================
# Helping Services Sub-Backend - Render Production Environment Variables Template
# Copy and paste these into your Render Web Service > "Environment" tab.
# ==============================================================================

NODE_ENV=production
ENVIRONMENT=production
PROJECT_NAME="Helping Services Sub-Backend"
VERSION=1.0.0
API_V1_STR=/api/v1
HOST=0.0.0.0

# Render automatically assigns PORT (usually 10000). Leave commented or set to 10000:
# PORT=10000

# CORS Allowed Origins (Comma-separated or JSON array)
BACKEND_CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# Interconnected Backends Topology
# ------------------------------------------------------------------------------
MAIN_BACKEND_URL=https://helper-fullstack-backend-selc.onrender.com
BACKEND2_URL=https://backend2-helping-serivce.onrender.com
BACKEND3_URL=https://backend3-helping-services.onrender.com
BACKEND4_URL=https://backend3-helping-services.onrender.com
RENDER_EXTERNAL_URL=https://backend2-helping-serivce.onrender.com

# ------------------------------------------------------------------------------
# Anti-Sleep Live Ping Keep-Alive Engine
# ------------------------------------------------------------------------------
LIVE_PING_ENABLED=true
LIVE_PING_INTERVAL_MINUTES=10
LIVE_PING_URL=https://backend2-helping-serivce.onrender.com/live-ping
LIVE_PING_EXTERNAL_TARGETS=https://helper-fullstack-backend-selc.onrender.com/api/v1/health,https://backend3-helping-services.onrender.com/live-ping

# ------------------------------------------------------------------------------
# Interconnected MongoDB Databases (Dedicated Sub-Backend 2 Clusters)
# ------------------------------------------------------------------------------
# If using a single MongoDB Atlas cluster with separate databases:
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# 1. Orders & Billing DB (Orders, Assignments, Printing, Razorpay Receipts)
MONGODB_ORDERS_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_ORDERS_DB_NAME=helping_sub2_orders

# 2. Partner Fleet & Wallets DB (Partner Profiles, Live States, Escrow Wallets)
MONGODB_FLEET_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_FLEET_DB_NAME=helping_sub2_fleet

# 3. Real-Time Telemetry & Geofencing DB (Live GPS Breadcrumbs, Device Health)
MONGODB_TELEMETRY_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_TELEMETRY_DB_NAME=helping_sub2_telemetry

MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# ------------------------------------------------------------------------------
# Zero-Trust Security Secrets
# ------------------------------------------------------------------------------
ADMIN_SUB_BACKEND_SECRET=helping-services-admin-sub-backend-secret-2026
ANALYSIS_ENGINE_SECRET=helping-services-analysis-engine-secret-2026
JWT_SECRET=helping-services-jwt-super-secret-key-2026

# ------------------------------------------------------------------------------
# Geospatial & Navigation Engine Keys
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIzaSyASKhpfg8Ax1V7iTN5ZXx9Lzc2E-lX4_uI
MAPPLS_API_KEY=epdccakxxpiaskznoidkzaqidtjaawiodxbl

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Live / Test Credentials)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_Sm2gHurbaF3hQG
RAZORPAY_KEY_SECRET=bGBP3yw2puNKeyyD8nVMYac5
RAZORPAY_WEBHOOK_SECRET=helping-services-razorpay-webhook-secret-2026

# ------------------------------------------------------------------------------
# Main Backend Interconnect
