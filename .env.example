# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME="Helping Services Sub-Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration (Sub-Backend runs on port 8001)
HOST="0.0.0.0"
PORT=8001

# CORS Allowed Origins (JSON array or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ==========================================
# Security & Sub-Backend Handshake Credentials
# ==========================================
# Shared secret for authenticating incoming webhooks from Main Backend
ADMIN_SUB_BACKEND_SECRET="helping-services-admin-sub-backend-secret-2026"
ANALYSIS_ENGINE_SECRET="helping-services-analysis-engine-secret-2026"

# JWT Secret for operator / admin tokens
JWT_SECRET="helping-services-jwt-super-secret-key-2026"

# ==========================================
# Main Backend Integration
# ==========================================
MAIN_BACKEND_URL="http://localhost:8000"

# ==========================================
# Database Configuration (3 Interconnected MongoDB Databases)
# ==========================================
# Dedicated Analytics MongoDB cluster (can also fallback to single MONGODB_URL)
MONGODB_URL="mongodb+srv://helpingservicesteam_db_user:uJMLbTmxbIReZLOV@cluster0.3p4hb11.mongodb.net/helping_services_analytics?retryWrites=true&w=majority"
MONGODB_DB_NAME="helping_services_analytics"

# 1. Core / Identity DB (Users, Roles, Partner Profiles, Wallets, User Order Profiles)
MONGODB_CORE_URL="mongodb+srv://helpingservicesteam_db_user:MY93vaWlypaCSwMf@cluster0.pyawg8c.mongodb.net/helping_services_core?compressors=zlib&retryWrites=true&w=majority"
MONGODB_CORE_DB_NAME="helping_services_core"

# 2. Product Catalog DB (Admin Uploads, Products, Pricing in ₹, Categories, Stock)
MONGODB_CATALOG_URL="mongodb+srv://helpingservicesteam_db_user:vS0ZqeRuEsHTBUzi@cluster0.vmzf51i.mongodb.net/helping_services_catalog?retryWrites=true&w=majority"
MONGODB_CATALOG_DB_NAME="helping_services_catalog"

# 3. User Intelligence & Analytics DB (Live Locations, Orders, Lifecycle, Devices, Alerts)
MONGODB_ANALYTICS_URL="mongodb+srv://helpingservicesteam_db_user:uJMLbTmxbIReZLOV@cluster0.3p4hb11.mongodb.net/helping_services_analytics?retryWrites=true&w=majority"
